│   │   ├── storage/                # Stockage (localStorage)
│   │   ├── validation/             # Validation (InputPattern)
│   │   └── helpers/                # Helpers génériques (clipboard, guid, objects, performance)
│   ├── specs/
│   │   ├── common/                 # Spécifications communes (animations, responsive, theme, validation)
│   │   └── components/             # Spécifications par composant (appbar, card, dialog, etc.)
│   ├── libs/
│   │   ├── js/                     # Bibliothèques JS externes (anime, jquery, mapbox)
│   │   └── ts/                     # Bibliothèques TS externes
│   ├── config/
│   │   ├── defaults.ts             # Configurations par défaut (Icon, SoundFX, Component options)
│   │   ├── selectors.ts            # Sélecteurs CSS par défaut (AutoInit)
│   │   └── index.ts                # Point d'entrée des configurations
│   ├── types/
│   │   ├── base/                   # Types de base (dom, element, interfaces, options, priority)
│   │   ├── components/             # Types des composants (base, registry, events)
│   │   ├── managers/               # Types pour les managers
│   │   └── utils/                  # Types utilitaires
│   └── index.ts                    # Point d'entrée src/
├── package.json            # Dépendances et scripts NPM
├── jest.config.js          # Configuration Jest (tests unitaires)
├── generate-docs.js        # Génération de la documentation (docs)
├── tsconfig.json           # Configuration TypeScript (compilation stricte)
├── vite.config.js          # Configuration Vite (exclut les assets du build)
├── .cursorrules            # Règles Cursor/éditeur pour le repo
└── README.md               # Documentation du projet (guide d’utilisation)
```

## Configuration et initialisation

### AutoInit par défaut

```html
<script src="dist/js/k3ui.min.js"></script>
<div class="chip">Chip automatique</div>
<div class="dialog">
  <div class="dialog__content">Contenu du dialogue</div>
</div>
```

### Configuration personnalisée

```html
<script src="dist/js/init.js"></script>
<script src="dist/js/k3ui.min.js"></script>
```

```javascript
