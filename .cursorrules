│   │   ├── Snackbar.ts             # Composant de notification snackbar
│   │   ├── Textarea.ts             # Composant de zone de texte
│   │   ├── Toast.ts                # Composant de notification toast
│   │   └── Tooltips.ts             # Composant d'infobulles
│   ├── utils/
│   │   ├── dom/                    # Utilitaires DOM (elements, positioning, touch, aria, etc.)
